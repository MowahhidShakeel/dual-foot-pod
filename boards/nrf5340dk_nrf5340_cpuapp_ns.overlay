/ {
    aliases {
        led0 = &led0;
        sw0 = &button0;
    };

    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
            label = "Green LED 0";
        };
    };

    buttons {
        compatible = "gpio-keys";
        button0: button_0 {
            gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
            label = "Button 0";
        };
    };
};

// &spi4 {
//     compatible = "nordic,nrf-spim";
//     status = "okay";
//     cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;  /* Chip Select pin P1.12 */

//     ism330dhcx@0 {
//         compatible = "st,ism330dhcx";
//         reg = <0>;                        /* CS index */
//         spi-max-frequency = <10000000>;   /* 10 MHz  */
//         label = "ISM330DHCX";
//     };
// };
&spi4 {
    status = "okay";
    pinctrl-0 = <&spi4_default>;
    pinctrl-1 = <&spi4_sleep>;
    pinctrl-names = "default", "sleep";

    /* * THE FIX: The cs-gpios property belongs to the SPI controller itself.
     * This tells spi4 that it is in charge of toggling this pin.
     */
    cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;

    /* This is the node for your sensor */
    ism330dlc: ism330dhcx@0 {
        compatible = "st,ism330dhcx";
        /* * The reg = <0> property now links this device to the 
         * first (index 0) chip select pin defined in the parent's
         * cs-gpios property above.
         */
        reg = <0>; 
        spi-max-frequency = <1000000>;
    };
};

/* Your pinctrl node remains the same */
&pinctrl {
	spi4_default: spi4_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
					<NRF_PSEL(SPIM_MOSI, 1, 13)>,
					<NRF_PSEL(SPIM_MISO, 1, 14)>;
		};
	};

	spi4_sleep: spi4_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
					<NRF_PSEL(SPIM_MOSI, 1, 13)>,
					<NRF_PSEL(SPIM_MISO, 1, 14)>;
			low-power-enable;
		};
	};
};